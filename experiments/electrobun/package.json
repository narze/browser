{
  "name": "browser-electrobun-cef",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "vp build",
    "build": "vp build && electrobun build --env=dev",
    "start": "electrobun run",
    "dev": "vp build && electrobun dev --watch",
    "dev:ui": "vp dev",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.3.5",
    "@types/node": "^26.0.0",
    "electrobun": "2.0.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
