{
  "name": "browser-prototype",
  "version": "0.1.0",
  "private": true,
  "description": "A browser prototype with Arc and Zen style tabs.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "dev:ui": "vp dev",
    "build": "vp build && vp build --config vite.preload.config.ts",
    "start": "node scripts/start.mjs",
    "package": "pnpm build && electron-builder --mac",
    "test:package": "pnpm package && playwright test -c playwright.packaged.config.ts",
    "check": "vp check && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "vp fmt",
    "test": "vp test run",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "electron-chrome-web-store": "0.13.0",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.0",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "optionalDependencies": {
    "node-mac-permissions": "github:codebytere/node-mac-permissions#f52b2cfcf6e05f2e6798ca06b8008db79ffa835a"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-mac-permissions"
    ]
  }
}
